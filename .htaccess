Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve internals.
  RewriteRule ^(app|views|content|database|routes)(/|$) - [F,L]
  RewriteRule ^config\.php$ - [F,L]
  RewriteRule ^downloads/.*\.(txt|sha256)$ - [F,L]

  # Real files (assets) are served directly; everything else goes to the router.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# IPA files always download instead of opening in the browser.
<FilesMatch "\.ipa$">
  ForceType application/octet-stream
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

# iOS only offers to install a profile when it is served with this type.
AddType application/x-apple-aspen-config .mobileconfig
